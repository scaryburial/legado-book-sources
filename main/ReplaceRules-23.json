  "order": 2,
  "pattern": "(?im)^.*(?:请记住|记住本站|记住本书|收藏本站|本站(?:地址|域名|网址|永久)|最新(?:网址|地址|域名)|永久(?:域名|网址)|备用网址).*$",
  "replacement": "",
